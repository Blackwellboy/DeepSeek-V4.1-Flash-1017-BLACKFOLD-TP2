new file mode 100644
index 0000000..3ac6330
--- /dev/null
+++ b/zig/src/server/schema_prompt.zig
@@ -0,0 +1,92 @@
+//! Structured output by instruction, for an engine that cannot enforce a grammar (Info.structures false).
+//!
+//! Ported from sushi (https://github.com/beamivalice/sushi, MIT, commit 3fc47d8a460970b1e86b24de1cab3b0f2067bc72),
+//! src/server.zig's response_format handling: the schema (or the JSON-only rule) goes into the system message, so a
+//! response_format request is served instead of refused with HTTP 400. Nothing masks the decode: the reply follows
+//! the schema only as well as the model follows the instruction (see docs/api.md, "Structured output").
+const std = @import("std");
+const json = @import("json.zig");
+const grammar = @import("grammar.zig");
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+
+/// Whether a spec of this kind can be served by instruction (EBNF grammars cannot: they stay refused).
+pub fn servable(kind: grammar.Kind) bool {
+    return kind != .grammar;
+}
+
+/// The instruction for one spec, as sushi words it.
+pub fn instruction(a: Allocator, spec: grammar.Spec) Allocator.Error![]const u8 {
+    return switch (spec.kind) {
+        .json => "Respond with valid JSON only. No other text, no markdown fences (no ``` or ```json), no explanation. Begin your response with `{` or `[`.",
+        .json_schema => try std.mem.concat(a, u8, &.{ "Respond with valid JSON only. No other text, no markdown, no explanation. Your response MUST conform to this JSON schema:\n", spec.text }),
+        .choice => try std.mem.concat(a, u8, &.{ "Respond with exactly one of the following strings and nothing else (no quotes, no explanation): ", spec.text }),
+        .regex => try std.mem.concat(a, u8, &.{ "Respond with text that fully matches this regular expression and nothing else (no explanation, no markdown):\n", spec.text }),
+        .grammar => unreachable,
+    };
+}
+
+/// ``messages`` with ``text`` added to the leading system message (after a blank line), or a new system message
+/// in front when there is none. The input is not changed.
+pub fn inject(a: Allocator, messages: Value, text: []const u8) Allocator.Error!Value {
+    const items = messages.items() orelse return messages;
+    if (items.len > 0 and items[0] == .object) {
+        const role = items[0].strField("role") orelse "";
+        if (std.mem.eql(u8, role, "system") or std.mem.eql(u8, role, "developer")) {
+            const first = try json.copyObject(a, items[0].object);
+            const content = first.get("content") orelse Value.null;
+            switch (content) {
+                .string => |s| try first.put(a, "content", .{ .string = if (s.len > 0) try std.mem.concat(a, u8, &.{ s, "\n\n", text }) else text }),
+                .array => |parts| {
+                    const part = try json.newObject(a);
+                    try part.put(a, "type", .{ .string = "text" });
+                    try part.put(a, "text", .{ .string = try std.mem.concat(a, u8, &.{ "\n\n", text }) });
+                    const grown = try a.alloc(Value, parts.len + 1);
+                    @memcpy(grown[0..parts.len], parts);
+                    grown[parts.len] = .{ .object = part };
+                    try first.put(a, "content", .{ .array = grown });
+                },
+                else => try first.put(a, "content", .{ .string = text }),
+            }
+            const out = try a.dupe(Value, items);
+            out[0] = .{ .object = first };
+            return .{ .array = out };
+        }
+    }
+    const sys = try json.newObject(a);
+    try sys.put(a, "role", .{ .string = "system" });
+    try sys.put(a, "content", .{ .string = text });
+    const out = try a.alloc(Value, items.len + 1);
+    out[0] = .{ .object = sys };
+    @memcpy(out[1..], items);
+    return .{ .array = out };
+}
+
+test "inject appends to a leading system message and leaves the input alone" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const msgs = (try json.parse(a, "[{\"role\": \"system\", \"content\": \"Be brief.\"}, {\"role\": \"user\", \"content\": \"hi\"}]")).ok;
+    const out = try inject(a, msgs, "JSON only.");
+    try std.testing.expectEqualStrings("Be brief.\n\nJSON only.", out.items().?[0].strField("content").?);
+    try std.testing.expectEqualStrings("Be brief.", msgs.items().?[0].strField("content").?);
+    try std.testing.expectEqual(@as(usize, 2), out.items().?.len);
+}
+
+test "inject adds a system message when there is none" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const msgs = (try json.parse(a, "[{\"role\": \"user\", \"content\": \"hi\"}]")).ok;
+    const out = try inject(a, msgs, "JSON only.");
+    try std.testing.expectEqual(@as(usize, 2), out.items().?.len);
+    try std.testing.expectEqualStrings("system", out.items().?[0].strField("role").?);
+    try std.testing.expectEqualStrings("JSON only.", out.items().?[0].strField("content").?);
+}
+
+test "the schema instruction carries the schema" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const text = try instruction(arena.allocator(), .{ .kind = .json_schema, .text = "{\"type\": \"object\"}" });
+    try std.testing.expect(std.mem.indexOf(u8, text, "MUST conform to this JSON schema:\n{\"type\": \"object\"}") != null);
+}
