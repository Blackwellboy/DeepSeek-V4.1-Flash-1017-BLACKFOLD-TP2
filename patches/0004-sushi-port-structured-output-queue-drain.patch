+# DeepSeek-V4.1 chat template (from sushi)
+
+- `chat_template.jinja`: DeepSeek-V4.1 chat template transcribed from the release's `encoding/encoding.py`
+  (chat and thinking modes, reasoning_effort low/high/max, DSML tool markup).
+- `template_cases.json`: 14 reference renders made by the release encoder (`dump_dsv41_template_cases.py`).
+
+Source: sushi, https://github.com/beamivalice/sushi (MIT, Copyright (c) the sushi authors), commit
+3fc47d8a460970b1e86b24de1cab3b0f2067bc72: `src/fixtures/dsv41_chat_template.jinja`,
+`src/fixtures/dsv41_template_cases.json`, `tests/dump_dsv41_template_cases.py`. Unmodified.
+
+Check (TensorFold's own Jinja renderer, byte for byte):
+
+    zig build test-dsv41-template
+    # or any template against the cases:
+    zig build tf-dsv41-template-cases && zig-out/bin/tf-dsv41-template-cases <template.jinja> assets/dsv41/template_cases.json
diff --git a/assets/dsv41/chat_template.jinja b/assets/dsv41/chat_template.jinja
new file mode 100644
index 0000000..3ef68f7
--- /dev/null
+++ b/assets/dsv41/chat_template.jinja
@@ -0,0 +1,79 @@
+{#- DeepSeek-V4.1, transcribed from the release's encoding/encoding.py (text path) for
+    jinja.cpp: no dict merges or chained comparisons. Pinned byte-exact against the
+    encoder by tests/dump_dsv41_template_cases.py over the shapes the server sends. jinja.cpp
+    drops a newline right after a block tag, so those are spelled out.
+    Kwargs: thinking_mode ("chat" | "thinking"; enable_thinking also accepted),
+    reasoning_effort (low | high | max, or 1-100; default high). -#}
+{%- if thinking_mode is not defined -%}
+{%- set thinking_mode = 'thinking' if (enable_thinking is defined and enable_thinking) else 'chat' -%}
+{%- endif -%}
+{%- set thinking = thinking_mode == 'thinking' -%}
+{%- set effort = reasoning_effort if (reasoning_effort is defined and reasoning_effort is not none) else 'high' -%}
+{%- set budgets = {'low': 50, 'high': 75, 'max': 100} -%}
+{%- set budget = budgets[effort] if effort is string else effort -%}
+{%- set DSML = '｜DSML｜' -%}
+{#- A late system turn counts as a user turn; tools anywhere keep every thought. -#}
+{%- set st = namespace(last_user=-1, prev='') -%}
+{%- for m in messages -%}
+{%- if m['role'] == 'user' or m['role'] == 'tool' or (m['role'] == 'system' and not loop.first) -%}
+{%- set st.last_user = loop.index0 -%}
+{%- endif -%}
+{%- endfor -%}
+{%- set drop = not tools -%}
+<｜begin▁of▁sentence｜>
+{%- set lead_system = messages|length > 0 and messages[0]['role'] == 'system' -%}
+{%- if thinking or lead_system or tools -%}<｜System｜>{%- endif -%}
+{%- if thinking -%}Reasoning Effort: {{ budget }} (range 1-100, the higher the value, the more thorough the reasoning)
+
+{% endif -%}
+{%- if lead_system -%}{{- messages[0]['content'] or '' -}}{%- endif -%}
+{%- if tools -%}{{ '\n\n' }}## Tools
+
+You have access to a set of tools to help answer the user's question. You can invoke tools by writing a "<{{ DSML }} calls>" block like the following:
+
+<{{ DSML }} calls>
+<{{ DSML }} invoke name="$TOOL_NAME">
+<{{ DSML }} parameter name="$PARAMETER_NAME" string="true|false">$PARAMETER_VALUE</{{ DSML }} parameter>
+...
+</{{ DSML }} invoke>
+<{{ DSML }} invoke name="$TOOL_NAME2">
+...
+</{{ DSML }} invoke>
+</{{ DSML }} calls>
+
+String parameters should be specified as is and set `string="true"`. For all other types (numbers, booleans, arrays, objects), pass the value in JSON format and set `string="false"`.
+
+If thinking_mode is enabled (triggered by <think>), you MUST output your complete reasoning inside <think>...</think> BEFORE any tool calls or final response.
+
+Otherwise, output directly after </think> with tool calls or final response.
+
+### Available Tool Schemas
+
+{% for t in tools %}{{ (t['function'] if t['function'] is defined else t) | tojson }}{% if not loop.last %}{{ '\n' }}{% endif %}{% endfor %}{{ '\n\n' }}You MUST strictly follow the above defined tool name and parameter schemas to invoke tool calls.
+{% endif -%}
+{%- for m in messages -%}
+{%- set idx = loop.index0 -%}
+{%- if m['role'] == 'system' -%}
+{%- if not loop.first -%}<｜System｜>{{- m['content'] or '' -}}{%- endif -%}
+{%- elif m['role'] == 'user' -%}
+{%- if st.prev == 'user' -%}{{- '\n\n' -}}{%- else -%}<｜User｜>{%- endif -%}{{- m['content'] or '' -}}
+{%- elif m['role'] == 'tool' -%}
+{%- if st.prev == 'user' -%}{{- '\n\n' -}}{%- else -%}<｜User｜>{%- endif -%}<tool_result>{{- m['content'] or '' -}}</tool_result>
+{%- elif m['role'] == 'assistant' -%}
+{%- if thinking and (not drop or idx > st.last_user) -%}{{- m['reasoning_content'] if m['reasoning_content'] is string else '' -}}</think>{%- endif -%}
+{{- m['content'] or '' -}}
+{%- if m['tool_calls'] -%}{{ '\n\n' }}<{{ DSML }} calls>
+{% for tc in m['tool_calls'] %}<{{ DSML }} invoke name="{{ tc['function']['name'] }}">
+{% for k, v in tc['function']['arguments'] | items %}<{{ DSML }} parameter name="{{ k }}" string="{{ 'true' if v is string else 'false' }}">{{ v if v is string else v | tojson }}</{{ DSML }} parameter>
+{% endfor %}</{{ DSML }} invoke>
+{% endfor %}</{{ DSML }} calls>
+{%- endif -%}
+<｜end▁of▁sentence｜>
+{%- endif -%}
+{#- The assistant turn opens after the last user-side message before it. -#}
+{%- set user_side = m['role'] in ['user', 'tool'] or (m['role'] == 'system' and not loop.first) -%}
+{%- set st.prev = 'user' if m['role'] in ['user', 'tool'] else m['role'] -%}
+{%- if user_side and ((loop.last and add_generation_prompt) or (not loop.last and messages[idx + 1]['role'] == 'assistant')) -%}
+<｜Assistant｜>{%- if thinking and (not drop or idx >= st.last_user) -%}<think>{%- else -%}</think>{%- endif -%}
+{%- endif -%}
+{%- endfor -%}
diff --git a/assets/dsv41/dump_dsv41_template_cases.py b/assets/dsv41/dump_dsv41_template_cases.py
new file mode 100644
index 0000000..003da16
--- /dev/null
+++ b/assets/dsv41/dump_dsv41_template_cases.py
@@ -0,0 +1,108 @@
+#!/usr/bin/env python3
+"""Byte-exact reference for the embedded DeepSeek-V4.1 chat template: the release's own
+`encoding/encoding.py` renders the shapes the server sends, and the Zig test renders the same
+cases through jinja.cpp.
+
+  python3 -I tests/dump_dsv41_template_cases.py --encoding <DeepSeek-V4.1-Flash>/encoding \
+      [--dump src/fixtures/dsv41_template_cases.json]
+
+The server hands the template tool-call `arguments` as objects, omits `reasoning_content` when
+absent, and passes `thinking_mode` and the effort word it mapped (low|high|max).
+"""
+import argparse
+import importlib.util
+import json
+import sys
+
+TOOLS = [{"type": "function", "function": {"name": "get_weather", "description": "Get weather", "parameters": {
+    "type": "object", "properties": {"city": {"type": "string"}, "days": {"type": "integer"}}, "required": ["city"]}}}]
+SIMPLE = [{"role": "user", "content": "Weather in Paris?"}]
+WITH_SYSTEM = [{"role": "system", "content": "You are helpful."}] + SIMPLE
+TOOL_ROUND = WITH_SYSTEM + [
+    {"role": "assistant", "content": "", "reasoning_content": "Need the tool.",
+     "tool_calls": [{"id": "tc_0", "type": "function", "function": {"name": "get_weather", "arguments": {"city": "Paris", "days": 3}}}]},
+    {"role": "tool", "content": "Sunny, 22C", "tool_call_id": "tc_0"},
+]
+HISTORY = [
+    {"role": "user", "content": "Why is the sky blue?"},
+    {"role": "assistant", "content": "Rayleigh scattering.", "reasoning_content": "Shorter wavelengths scatter more."},
+    {"role": "user", "content": "And sunsets?"},
+]
+PARALLEL = [
+    {"role": "user", "content": "Weather in Paris and Rome?"},
+    {"role": "assistant", "content": "", "tool_calls": [
+        {"id": "a", "type": "function", "function": {"name": "get_weather", "arguments": {"city": "Paris"}}},
+        {"id": "b", "type": "function", "function": {"name": "get_weather", "arguments": {"city": "Rome"}}}]},
+    {"role": "tool", "content": "Paris: sunny, 22C", "tool_call_id": "a"},
+    {"role": "tool", "content": "Rome: cloudy, 19C", "tool_call_id": "b"},
+]
+LATE_SYSTEM = [
+    {"role": "user", "content": "Hi"},
+    {"role": "assistant", "content": "Hello.", "reasoning_content": "Greet."},
+    {"role": "system", "content": "Answer in French."},
+    {"role": "user", "content": "How are you?"},
+]
+TWO_USERS = [{"role": "user", "content": "First."}, {"role": "user", "content": "Second."}]
+
+# (label, messages, tools, thinking_mode, reasoning_effort)
+CASES = [
+    ("simple/chat", SIMPLE, None, "chat", "low"),
+    ("simple/thinking low", SIMPLE, None, "thinking", "low"),
+    ("simple/thinking high", SIMPLE, None, "thinking", "high"),
+    ("simple/thinking max", SIMPLE, None, "thinking", "max"),
+    ("system+tools/chat", WITH_SYSTEM, TOOLS, "chat", "low"),
+    ("system+tools/thinking", WITH_SYSTEM, TOOLS, "thinking", "high"),
+    ("tools, no system/thinking", SIMPLE, TOOLS, "thinking", "high"),
+    ("tool round/chat", TOOL_ROUND, TOOLS, "chat", "low"),
+    ("tool round/thinking", TOOL_ROUND, TOOLS, "thinking", "high"),
+    ("history drops thinking/thinking", HISTORY, None, "thinking", "high"),
+    ("history/chat", HISTORY, None, "chat", "low"),
+    ("parallel calls/thinking", PARALLEL, TOOLS, "thinking", "high"),
+    ("late system turn/thinking", LATE_SYSTEM, None, "thinking", "high"),
+    ("consecutive users/chat", TWO_USERS, None, "chat", "low"),
+]
+
+
+def load_encoder(encoding_dir):
+    spec = importlib.util.spec_from_file_location("dsv41_encoding", encoding_dir + "/encoding.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def reference(enc, messages, tools, mode, effort):
+    msgs = json.loads(json.dumps(messages))
+    for m in msgs:
+        for tc in m.get("tool_calls", []):
+            tc["function"]["arguments"] = json.dumps(tc["function"]["arguments"], ensure_ascii=False)
+    if tools:
+        # the encoder takes tools on the leading system message, as the release's own inputs do
+        if msgs and msgs[0]["role"] == "system":
+            msgs[0]["tools"] = tools
+        else:
+            msgs.insert(0, {"role": "system", "content": "", "tools": tools})
+    return enc.encode_messages(msgs, thinking_mode=mode, reasoning_effort=effort)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--encoding", required=True)
+    ap.add_argument("--dump")
+    args = ap.parse_args()
+    enc = load_encoder(args.encoding)
+    out = []
+    for label, messages, tools, mode, effort in CASES:
+        out.append({"label": label, "messages": messages, "tools": tools, "thinking_mode": mode,
+                    "reasoning_effort": effort, "expected": reference(enc, messages, tools, mode, effort)})
+    if args.dump:
+        with open(args.dump, "w") as f:
+            json.dump(out, f, ensure_ascii=False, indent=1)
+            f.write("\n")
+    else:
+        for c in out:
+            print(c["label"], repr(c["expected"][:120]))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
