@@ -0,0 +1,50 @@
+//! Renders sushi's 14 DeepSeek-V4.1 reference cases (assets/dsv41/template_cases.json, made by the release's own
+//! encoding.py) through TensorFold's Jinja renderer and compares bytes. Ported from sushi's chat.zig test
+//! "the embedded V4.1 template renders ... byte-exact with DeepSeek's encoder" (MIT, beamivalice/sushi @ 3fc47d8).
+//! usage: tf-dsv41-template-cases <template.jinja> <template_cases.json>   (exit 1 on any mismatch)
+const std = @import("std");
+const template = @import("template");
+const V = std.json.Value;
+
+pub fn main(init: std.process.Init) !void {
+    const a = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len != 3) {
+        std.debug.print("usage: tf-dsv41-template-cases <template.jinja> <template_cases.json>\n", .{});
+        return error.InvalidArguments;
+    }
+    const source = try std.Io.Dir.cwd().readFileAlloc(init.io, args[1], a, .limited(1 << 24));
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(init.io, args[2], a, .limited(1 << 26));
+    const cases = (try std.json.parseFromSlice(V, a, bytes, .{})).value.array.items;
+    var diag = template.Diag{};
+    const t = template.compile(std.heap.page_allocator, source, &diag) catch |e| {
+        std.debug.print("template does not compile: {s}\n", .{diag.msg});
+        return e;
+    };
+    var bad: usize = 0;
+    for (cases) |case| {
+        const o = case.object;
+        const label = o.get("label").?.string;
+        var ctx: std.json.ObjectMap = .init(a);
+        try ctx.put("thinking_mode", o.get("thinking_mode").?);
+        try ctx.put("reasoning_effort", o.get("reasoning_effort").?);
+        var d = template.Diag{};
+        const got = template.render(a, &t, o.get("messages").?, o.get("tools").?, .{ .object = ctx }, true, &d) catch |e| {
+            if (e == error.OutOfMemory) return e;
+            std.debug.print("FAIL {s}: render error: {s}\n", .{ label, d.msg });
+            bad += 1;
+            continue;
+        };
+        const want = o.get("expected").?.string;
+        if (std.mem.eql(u8, got, want)) {
+            std.debug.print("ok   {s}\n", .{label});
+        } else {
+            bad += 1;
+            const at = std.mem.indexOfDiff(u8, got, want) orelse 0;
+            const lo = at -| 40;
+            std.debug.print("FAIL {s}: first difference at byte {d}\n  want: {f}\n  got:  {f}\n", .{ label, at, std.zig.fmtString(want[lo..@min(want.len, at + 40)]), std.zig.fmtString(got[lo..@min(got.len, at + 40)]) });
+        }
+    }
+    std.debug.print("{d} cases, {d} byte-exact, {d} mismatches\n", .{ cases.len, cases.len - bad, bad });
+    if (bad > 0) std.process.exit(1);
+}
-- 
