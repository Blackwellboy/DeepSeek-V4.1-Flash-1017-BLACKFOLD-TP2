 }
+
+// BLACKFOLD experiment: a backend may opt out of suffix-lookup copies; upstream gates otherwise unchanged.
+fn copyAllowed(enabled: bool, max_copy: u32, forced: usize) bool {
+    return enabled and max_copy != 0 and forced == 0;
+}
+test "BLACKFOLD copy opt-out only closes the copy gate" {
+    try std.testing.expect(copyAllowed(true, 5, 0));
