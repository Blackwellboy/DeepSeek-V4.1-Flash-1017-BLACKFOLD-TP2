# Copy to deploy/blackfold.env on the head node and fill in. Read by deploy/blackfold-native.

# Head (rank 0) primary fabric IPv4, used as the TP master address.
HEAD_ADDR=CHANGE_ME
# SSH alias of the worker (rank 1), reachable from the head without a password.
WORKER_SSH=CHANGE_ME
PORT=18191
SERVED_NAME=DeepSeek-v4.1-Flash-1017-heretic-tf

# RDMA devices and netdevs: primary port and its PCIe twin.
PRIMARY_HCA=rocep1s0f0
TWIN_HCA=roceP2p1s0f0
PRIMARY_NETDEV=enp1s0f0np0

# Container image of your base TensorFold TP2 deployment (same on both nodes).
IMAGE=CHANGE_ME

# Patched engine build trees (each contains engine/zig-out) on head and worker.
HEAD_BUILD=CHANGE_ME
WORKER_BUILD=CHANGE_ME
# Optional SHA-256 pins for the two binaries; leave empty to skip the check.
HEAD_SHA256=
WORKER_SHA256=

# Kit folders (kit v0.6.1 with the 1017 image-routing bias) and the adapted chat template, per node.
HEAD_KIT=CHANGE_ME
WORKER_KIT=CHANGE_ME
HEAD_TEMPLATE=CHANGE_ME
WORKER_TEMPLATE=CHANGE_ME

# Runtime model dir, Engram shards and rank cache folder: the same paths on both nodes.
MODEL_DIR=CHANGE_ME
ENGRAM_DIR=CHANGE_ME
CACHE_DIR=CHANGE_ME
